[Desktop Entry]
# TEMPLATE. @REPO@ is substituted for the checkout path by linux/install.sh,
# which renders this into ~/.local/share/applications/. Unlike a systemd unit a
# desktop entry has no "%h" specifier -- every % code here means something else
# to the spec -- so the absolute path has to be baked in at install time.
Type=Application
Name=murmur — push to talk
Comment=Holds a global shortcut and drives murmur's dictation socket
Exec=/usr/bin/python3 @REPO@/linux/murmur-ptt-binder.py
Icon=audio-input-microphone
Terminal=false
# Not something to launch from the menu — it exists so the GlobalShortcuts
# portal has a stable application identity to file the shortcut under. Without
# a desktop entry KDE attributes the shortcut to whatever launched the process
# (a terminal, typically) and it lands in that app's section of
# kglobalshortcutsrc instead of its own.
NoDisplay=true
Categories=Utility;
