[Unit]
Description=murmur push-to-talk portal binder
Documentation=file:%h/murmur/LINUX-PORT-NOTES.md
# The binder tolerates the shell being absent and reconnects, so it does not
# need to be ordered after it.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/murmur/linux/murmur-ptt-binder.py
Restart=on-failure
RestartSec=5
# Portal access needs the session bus and a desktop session; both come from the
# user manager's environment, which is why this is a --user unit.

[Install]
WantedBy=graphical-session.target
